{
  "deployment": {
    "enabled": true,
    "providerName": "Twilio",
    "languages": ["javascript"],
    "supportedEndpointRegions": ["global"],
    "authentication": {
      "mode": "apiKey",
      "identityKeyVaultSecretName": "twilio-api-key-id",
      "keyVaultSecretName": "twilio-api-key-secret"
    },
    "environmentVariables": {
      "TWILIO_VERIFY_SERVICE_SID": {
        "displayName": "Twilio Verify Service SID",
        "source": "input",
        "required": true,
        "validation": { "type": "pattern", "pattern": "^VA[0-9a-fA-F]{32}$" }
      }
    },
    "routes": {
      "global": {
        "smsEndpoint": "https://verify.twilio.com",
        "voiceEndpoint": "https://verify.twilio.com",
        "timeoutMilliseconds": 1500,
        "retryIntervalSeconds": 30
      }
    }
  }
}
